# Public URL of the deployed site (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ---- Contact form (Nodemailer / SMTP) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
# Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: display name / address for outgoing mail (address defaults to SMTP_USER)
SMTP_FROM_NAME=Juliet Ogbonna Portfolio
SMTP_FROM_EMAIL=

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=Julietng2020@gmail.com

# Send visitors an automatic "thanks, I got your message" email (true/false)
CONTACT_AUTO_REPLY=true
